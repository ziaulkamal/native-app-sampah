{
  "name": "native-app-sampah",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikasi Persampahan & Retribusi — Android (React Native + Expo Dev Client). Role Pelanggan & Operator; berbagi backend Laravel Octane dan design token dengan FE web design-app-sampah.",
  "main": "index.ts",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "gen:theme": "node scripts/gen-theme.mjs",
    "check:theme": "node scripts/gen-theme.mjs --check",
    "check:drift": "node scripts/gen-theme.mjs --drift",
    "doctor": "expo-doctor",
    "fix:versions": "expo install --fix"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "~15.15.4",
    "react-native-worklets": "~0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.17",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
